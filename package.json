{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "setup": "npm ci",
    "doctor": "node --no-warnings --experimental-strip-types ./scripts/verify-project.ts",
    "postinstall": "npm run doctor",
    "prestart": "npm run doctor",
    "start": "node ./scripts/expo-start.js",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --no-cache && deno lint --no-config supabase/functions",
    "test:unit": "node --no-warnings --experimental-strip-types --test tests/mayorAnalytics.test.ts tests/reportLocation.test.ts tests/notificationDates.test.ts tests/communityReportFeed.test.ts tests/officialAnnouncementFeed.test.ts tests/mediaPolicy.test.ts tests/navigation.test.ts tests/demoAuth.test.ts",
    "test": "npm run test:unit && npm run typecheck && npm run lint",
    "test:rls": "npx --yes supabase@latest test db"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.108.1",
    "expo": "~58.0.19",
    "expo-blur": "~58.0.5",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.12",
    "expo-video-thumbnails": "~58.0.2",
    "expo-web-browser": "~58.0.6",
    "lottie-react-native": "~7.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "supabase": "^2.117.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0 <25",
    "npm": ">=10"
  },
  "private": true
}
